{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Numo App",
  "version": "../package.json",
  "identifier": "app.numo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Numo",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 10,
          "y": 18
        },
        "backgroundColor": "#0c0c0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RTU5MzQwNEE0MjlGQjUKUldTMW4wSktRSlBsaDFrQTJZeldySmwxaFlvekZzOERuR0o4V3htOWE4SHI2ZzZQNzg2UE8vR3EK",
      "endpoints": [
        "https://github.com/Nyhz/numo-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
